[
 {
  "id": "c1",
  "cue": 1,
  "who": "N",
  "t0": 0.0,
  "t1": 4.06,
  "text": "Tiap kumpul keluarga, ada satu pertanyaan yang selalu datang."
 },
 {
  "id": "c2",
  "cue": 2,
  "who": "N",
  "t0": 4.26,
  "t1": 6.04,
  "text": "Lebih pasti dari THR."
 },
 {
  "id": "c3",
  "cue": 3,
  "who": "N",
  "t0": 6.62,
  "t1": 8.82,
  "text": "Namanya Rania. Umur dua puluh delapan."
 },
 {
  "id": "c4",
  "cue": 4,
  "who": "N",
  "t0": 9.64,
  "t1": 11.78,
  "text": "Hari ini ulang tahun Nenek yang ke-tujuh puluh lima,"
 },
 {
  "id": "c5",
  "cue": 5,
  "who": "N",
  "t0": 12.42,
  "t1": 14.64,
  "text": "dan Rania datang langsung dari kantor."
 },
 {
  "id": "c6",
  "cue": 6,
  "who": "N",
  "t0": 15.04,
  "t1": 17.24,
  "text": "Belum sempat duduk, Tante Rina sudah bertanya."
 },
 {
  "id": "c7",
  "cue": 7,
  "who": "rina",
  "t0": 17.8,
  "t1": 20.74,
  "text": "\"Rania, kapan nikah? Umur segini, lho.\""
 },
 {
  "id": "c8a",
  "cue": 8,
  "who": "N",
  "t0": 21.26,
  "t1": 22.396,
  "text": "Rania tersenyum."
 },
 {
  "id": "c8b",
  "cue": 8,
  "who": "rania",
  "t0": 22.396,
  "t1": 23.74,
  "text": "\"Doain aja, Tante.\""
 },
 {
  "id": "c9",
  "cue": 9,
  "who": "N",
  "t0": 24.3,
  "t1": 25.86,
  "text": "Tante Dewi ikut menyambar."
 },
 {
  "id": "c10",
  "cue": 10,
  "who": "dewi",
  "t0": 26.24,
  "t1": 28.58,
  "text": "\"Jangan kelamaan milih. Nanti keburu nggak laku.\""
 },
 {
  "id": "c11",
  "cue": 11,
  "who": "N",
  "t0": 28.58,
  "t1": 31.86,
  "text": "Senyum. Itu satu-satunya senjata Rania."
 },
 {
  "id": "c12a",
  "cue": 12,
  "who": "N",
  "t0": 32.32,
  "t1": 33.479,
  "text": "Om Budi menyusul."
 },
 {
  "id": "c12b",
  "cue": 12,
  "who": "budi",
  "t0": 33.479,
  "t1": 35.3,
  "text": "\"Adikmu aja udah mau nikah.\""
 },
 {
  "id": "c13",
  "cue": 13,
  "who": "budi",
  "t0": 35.54,
  "t1": 36.94,
  "text": "\"Masa kakaknya dilangkahi?\""
 },
 {
  "id": "c14a",
  "cue": 14,
  "who": "N",
  "t0": 37.38,
  "t1": 38.896,
  "text": "Tante Rina menambahkan,"
 },
 {
  "id": "c14b",
  "cue": 14,
  "who": "rina",
  "t0": 38.896,
  "t1": 41.58,
  "text": "\"Kerja terus, kerja terus. Mau jadi apa?\""
 },
 {
  "id": "c15",
  "cue": 15,
  "who": "rina",
  "t0": 42.02,
  "t1": 44.02,
  "text": "\"Perempuan itu ujung-ujungnya di dapur juga.\""
 },
 {
  "id": "c16",
  "cue": 16,
  "who": "N",
  "t0": 44.5,
  "t1": 47.1,
  "text": "Rania menunduk, mengaduk teh yang sudah dingin."
 },
 {
  "id": "c17",
  "cue": 17,
  "who": "N",
  "t0": 48.02,
  "t1": 50.68,
  "text": "Sepuluh menit. Tujuh pertanyaan."
 },
 {
  "id": "c18",
  "cue": 18,
  "who": "N",
  "t0": 50.98,
  "t1": 52.06,
  "text": "Rania sudah menghitung."
 },
 {
  "id": "c19",
  "cue": 19,
  "who": "N",
  "t0": 52.54,
  "t1": 55.02,
  "text": "Lalu Tante Rina bertanya lagi, lebih keras."
 },
 {
  "id": "c20",
  "cue": 20,
  "who": "rina",
  "t0": 55.02,
  "t1": 56.1,
  "text": "\"Calonnya mana?\""
 },
 {
  "id": "c21a",
  "cue": 21,
  "who": "rina",
  "t0": 56.56,
  "t1": 58.938,
  "text": "\"Atau jangan-jangan... nggak ada?\""
 },
 {
  "id": "c21b",
  "cue": 21,
  "who": "N",
  "t0": 58.938,
  "t1": 59.68,
  "text": "Semua diam."
 },
 {
  "id": "c22",
  "cue": 22,
  "who": "N",
  "t0": 60.52,
  "t1": 62.7,
  "text": "Rania meletakkan sendoknya, pelan."
 },
 {
  "id": "c23",
  "cue": 23,
  "who": "rania",
  "t0": 63.12,
  "t1": 65.86,
  "text": "\"Ada, Tante. Calonnya lagi sibuk banget.\""
 },
 {
  "id": "c24",
  "cue": 24,
  "who": "rina",
  "t0": 66.26,
  "t1": 68.72,
  "text": "\"Sibuk apa? Sampai nggak bisa datang ke acara Nenek?\""
 },
 {
  "id": "c25",
  "cue": 25,
  "who": "N",
  "t0": 69.16,
  "t1": 70.76,
  "text": "Rania menjawab, tenang."
 },
 {
  "id": "c26",
  "cue": 26,
  "who": "rania",
  "t0": 71.12,
  "t1": 72.3,
  "text": "\"Sibuk bayar ini semua.\""
 },
 {
  "id": "c27",
  "cue": 27,
  "who": "rania",
  "t0": 72.86,
  "t1": 74.94,
  "text": "\"Tenda, katering, sama sound system.\""
 },
 {
  "id": "c28",
  "cue": 28,
  "who": "rania",
  "t0": 75.3,
  "t1": 76.48,
  "text": "\"Tadi pagi baru lunas.\""
 },
 {
  "id": "c29",
  "cue": 29,
  "who": "N",
  "t0": 76.96,
  "t1": 80.0,
  "text": "Semua menoleh ke bapak katering, yang sedang memegang nota."
 },
 {
  "id": "c30",
  "cue": 30,
  "who": "N",
  "t0": 80.42,
  "t1": 82.12,
  "text": "Di situ tertulis nama Rania."
 },
 {
  "id": "c31a",
  "cue": 31,
  "who": "rania",
  "t0": 83.24,
  "t1": 85.188,
  "text": "\"Calonnya namanya Cicilan,\""
 },
 {
  "id": "c31b",
  "cue": 31,
  "who": "N",
  "t0": 85.188,
  "t1": 85.94,
  "text": "kata Rania."
 },
 {
  "id": "c32",
  "cue": 32,
  "who": "rania",
  "t0": 86.44,
  "t1": 88.52,
  "text": "\"Setia, Tante. Tiap bulan datang.\""
 },
 {
  "id": "c33",
  "cue": 33,
  "who": "N",
  "t0": 88.96,
  "t1": 91.2,
  "text": "Tante-tante terdiam. Ada yang batuk."
 },
 {
  "id": "c34",
  "cue": 34,
  "who": "N",
  "t0": 91.5,
  "t1": 93.46,
  "text": "Ada yang tiba-tiba sibuk ambil nasi."
 },
 {
  "id": "c35",
  "cue": 35,
  "who": "N",
  "t0": 93.84,
  "t1": 96.7,
  "text": "Nenek tersenyum kecil, lalu menepuk tangan Rania."
 },
 {
  "id": "c36",
  "cue": 36,
  "who": "N",
  "t0": 97.18,
  "t1": 99.44,
  "text": "Sejak hari itu, pertanyaannya berubah."
 },
 {
  "id": "c37",
  "cue": 37,
  "who": "N",
  "t0": 99.72,
  "t1": 101.28,
  "text": "Bukan lagi \"kapan nikah?\"..."
 },
 {
  "id": "c38a",
  "cue": 38,
  "who": "N",
  "t0": 101.62,
  "t1": 101.812,
  "text": "tapi,"
 },
 {
  "id": "c38b",
  "cue": 38,
  "who": "rina",
  "t0": 101.812,
  "t1": 104.24,
  "text": "\"Rania, ada lowongan di kantormu?\""
 }
]